CostaPellegrini.coefficient_identity {k : ℕ} (hk : 2 ≤ k) (j : Fin k) :
  CostaPellegrini.eCoefficient k j = (-1) ^ ((k - 1) / 2) * CostaPellegrini.cCoefficient k j
def CostaPellegrini.cExponent : (k : ℕ) → Fin k → Fin k →₀ ℕ :=
fun k j => Finsupp.onFinset Finset.univ (fun i => if i = j then k - 2 else k - 1) ⋯
def CostaPellegrini.eExponent : (k : ℕ) → Fin k → Fin k →₀ ℕ :=
fun k j => Finsupp.onFinset Finset.univ (fun i => if i = j then 0 else k) ⋯
def CostaPellegrini.cCoefficient : (k : ℕ) → Fin k → ℤ :=
fun k j =>
  (CostaPellegrini.vandermonde k * CostaPellegrini.deletedIntervalProduct k).coeff (CostaPellegrini.cExponent k j)
def CostaPellegrini.eCoefficient : (k : ℕ) → Fin k → ℤ :=
fun k j => (CostaPellegrini.vandermonde k * CostaPellegrini.intervalProduct k).coeff (CostaPellegrini.eExponent k j)
