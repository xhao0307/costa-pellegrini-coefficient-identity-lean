CostaPellegrini.intervalProduct_eq_totalSum_mul_deleted (k : ℕ) (hk : 2 ≤ k) :
  CostaPellegrini.intervalProduct k = CostaPellegrini.totalSum k * CostaPellegrini.deletedIntervalProduct k
CostaPellegrini.trace_X_mul_deleted_eq_c (k : ℕ) (hk : 2 ≤ k) (j : Fin k) :
  CostaPellegrini.trace k (MvPolynomial.X j * CostaPellegrini.deletedIntervalProduct k) =
    CostaPellegrini.cCoefficient k j
